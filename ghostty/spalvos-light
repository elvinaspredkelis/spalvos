# Spalvos Light — ghostty port of the spalvos color system
# Light mapping inspired by Kary Pro Colors Light, executed with
# spalvos primitives: mid-gray ink (Pro Colors #65758d ≈ neutral-600),
# accents at uniform lightness, cyan cursor + cyan-wash selection.
# Legibility pass: every text-capable slot pulled into the L≈39–61
# band — "bright = much lighter" melts into paper, so brights sit
# only one step above normals (Catppuccin Latte style).

# --- Core ---
# Foreground = neutral-800 (~9.5:1 on paper). Tuning history:
# neutral-600 was too washed for dense terminal text; neutral-950
# read as harsh near-black in long sessions; 800 is the soft spot.
background = #fafaf9
foreground = #343331

# --- ANSI palette ---
# Neutrals: black = neutral-700 — NOT the darkest ink. Slot 0 doubles
# as the background for inverse emphasis bars in TUIs (prompt bars,
# selected rows); at neutral-900 those read as jarring near-black
# slabs on paper, so it's softened to dark slate. Black-as-text
# becomes ~fg-colored, an accepted trade. bright black =
# neutral-500 (comment tone). White slots stay on the PAPER
# SURFACES: white = paper-sunken, bright white = paper-raised —
# white-as-text is a subtle inset tone by design.
# Accents: normals at L≈48–50 (rose/magenta 600, amber 700), brights
# one step lighter so they stay >= ~3.3:1 on paper. EXCEPTION — green:
# emerald-700 (L49) sat only ~17 L above the neutral-800 ink and
# read as dark gray in log streams, so green normal == bright ==
# emerald-600 (L59, higher chroma — unambiguously green). Blue
# duty runs on the CYAN ramp (spalvos blue is violet/hot at every
# step; cyan hue 200 ≈ Pro Colors' dusty azure): blue = cyan-700,
# cyan = cyan-600, brights 600/500. bright cyan (cyan-500, L72) is
# the one airy slot — like blue-on-dark, accents only, not body text.
palette = 0=#41403d
palette = 1=#b41b3c
palette = 2=#13955e
palette = 3=#954d0a
palette = 4=#087075
palette = 5=#a70881
palette = 6=#0d959b
palette = 7=#ebebea
palette = 8=#73716e
palette = 9=#de1c4a
palette = 10=#13955e
palette = 11=#c4660d
palette = 12=#0d959b
palette = 13=#cd059e
palette = 14=#11bbc2
palette = 15=#ffffff

# --- Extras ---
# Cursor = the Pro Colors cyan caret (cyan-500 ≈ #00BBEC in L and C),
# with true-black text so the block cursor stays readable.
cursor-color = #11bbc2
cursor-text = #0b0a09

# Selection = cyan-100 wash (≈ Pro Colors selection #CFF0F9)
selection-background = #cbf2f4
selection-foreground = #0b0a09
