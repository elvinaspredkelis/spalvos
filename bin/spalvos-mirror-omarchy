#!/usr/bin/env bash
# Sync the Omarchy themes into their standalone mirror repos.
#
# omarchy-theme-set installs a theme from a git URL whose ROOT is the theme
# directory — one theme per repo — so the two themes under omarchy/ are
# mirrored to omarchy-spalvos-light / omarchy-spalvos-dark. The mirrors are
# generated artifacts: never edit them directly, run this after changing
# the themes here.
#
# Usage: spalvos-mirror-omarchy [work-dir]   (default: ../ next to this repo)
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORK="${1:-$(dirname "$REPO")}"

for variant in light dark; do
  name="omarchy-spalvos-$variant"
  dest="$WORK/$name"
  if [[ ! -d "$dest/.git" ]]; then
    echo "spalvos-mirror-omarchy: $dest missing — clone it first:" >&2
    echo "  git clone git@github.com:elvinaspredkelis/$name.git $dest" >&2
    exit 1
  fi
  # Replace everything except .git with the current theme + docs.
  find "$dest" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
  cp -R "$REPO/omarchy/spalvos-$variant/." "$dest/"
  cp "$REPO/LICENSE" "$dest/LICENSE"
  cat > "$dest/README.md" <<MD
# Spalvos ${variant^} — Omarchy theme

Mirror of [\`spalvos\`](https://github.com/elvinaspredkelis/spalvos)'s
\`omarchy/spalvos-$variant\` — a standalone repo so Omarchy can install it
directly. Requires Omarchy 4.

![preview](preview.png)

## Install

Omarchy menu → Install → Style → Theme, paste this repo's URL. Or:

\`\`\`sh
omarchy theme install https://github.com/elvinaspredkelis/$name
\`\`\`

## Do not edit here

Generated by \`bin/spalvos-mirror-omarchy\` in the main repo. Palette
changes belong in [spalvos](https://github.com/elvinaspredkelis/spalvos) —
issues and PRs there, please.
MD
  git -C "$dest" add -A
  if git -C "$dest" diff --cached --quiet; then
    echo "spalvos-mirror-omarchy: $name unchanged"
  else
    src_rev="$(git -C "$REPO" rev-parse --short HEAD)"
    git -C "$dest" commit -q -m "sync from spalvos@$src_rev"
    git -C "$dest" push -q origin HEAD
    echo "spalvos-mirror-omarchy: $name synced (spalvos@$src_rev)"
  fi
done
