#!/usr/bin/env bash
# Apply the spalvos light or dark variant to the ports that CANNOT follow the
# desktop mode by themselves.
#
# Ghostty can: `theme = dark:spalvos-dark,light:spalvos-light` follows the GTK
# color-scheme. Fish can: fish/spalvos-theme.fish picks a variant per shell.
# Herdr cannot — its config has a single `[theme.custom]` table and no per-mode
# variant of it (herdr 0.7.5 `ThemeConfig` is exactly
# {auto_switch, dark_name, light_name, custom}), so the table has to be
# rewritten when the mode changes. That is what this script does.
#
# Usage:
#   spalvos-mode-apply [light|dark]     # omit to detect from the desktop
#
# Wire it to run on theme changes by calling it from
# ~/.config/omarchy/hooks/theme-set.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HERDR_CONFIG="${HERDR_CONFIG:-$HOME/.config/herdr/config.toml}"

BEGIN_MARK='# >>> spalvos theme — generated by spalvos-mode-apply, do not edit >>>'
END_MARK='# <<< spalvos theme <<<'

detect_mode() {
  # Same signal ghostty follows: omarchy writes the GTK color-scheme and drops a
  # `light.mode` marker into the active theme directory at the same time.
  if [[ -f "$HOME/.config/omarchy/current/theme/light.mode" ]]; then
    echo light
  elif [[ -d "$HOME/.config/omarchy/current/theme" ]]; then
    echo dark
  elif command -v gsettings >/dev/null 2>&1 &&
    [[ "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" == *light* ]]; then
    echo light
  else
    echo dark
  fi
}

MODE="${1:-$(detect_mode)}"
case "$MODE" in
light | dark) ;;
*)
  echo "spalvos-mode-apply: expected 'light' or 'dark', got '$MODE'" >&2
  exit 1
  ;;
esac

THEME_FILE="$REPO/herdr/spalvos-$MODE.toml"
[[ -r "$THEME_FILE" ]] || {
  echo "spalvos-mode-apply: missing $THEME_FILE" >&2
  exit 1
}

mkdir -p "$(dirname "$HERDR_CONFIG")"
touch "$HERDR_CONFIG"

# Splice the block in. Two things have to be stripped first, or the result is
# invalid TOML: a previous generated block, and any hand-written [theme] /
# [theme.*] table (a duplicate table is a parse error, not a merge).
BEGIN_MARK="$BEGIN_MARK" END_MARK="$END_MARK" THEME_FILE="$THEME_FILE" MODE="$MODE" \
  python3 - "$HERDR_CONFIG" <<'PY'
import os, re, sys

path = sys.argv[1]
begin, end = os.environ["BEGIN_MARK"], os.environ["END_MARK"]
block = open(os.environ["THEME_FILE"], encoding="utf-8").read().rstrip("\n")

with open(path, encoding="utf-8") as fh:
    lines = fh.read().splitlines()

out, skip_block, skip_table = [], False, False
for line in lines:
    if line.strip() == begin:
        skip_block = True
        continue
    if skip_block:
        if line.strip() == end:
            skip_block = False
        continue

    stripped = line.strip()
    if re.match(r"^\[\s*theme\s*(\..*)?\]$", stripped):
        # Drop this table and everything under it, up to the next table header.
        skip_table = True
        continue
    if skip_table:
        if stripped.startswith("[") and not re.match(r"^\[\s*theme\s*(\..*)?\]$", stripped):
            skip_table = False
        else:
            continue
    out.append(line)

# Trailing bare keys would end up INSIDE our [theme] table, so the block can
# only be appended if nothing but comments/blanks follows the last table header.
while out and not out[-1].strip():
    out.pop()

text = "\n".join(out)
if text:
    text += "\n\n"
text += f"{begin}\n{block}\n{end}\n"

with open(path, "w", encoding="utf-8") as fh:
    fh.write(text)
PY

echo "spalvos-mode-apply: herdr -> spalvos-$MODE ($HERDR_CONFIG)"

# Validate before asking the running server to take it.
if command -v herdr >/dev/null 2>&1; then
  if ! herdr config check; then
    echo "spalvos-mode-apply: herdr rejected the config (see above)" >&2
    exit 1
  fi
  # reload-config only works when a server is up; a fresh launch reads the file
  # anyway, so a failure here is not an error.
  if herdr server reload-config >/dev/null 2>&1; then
    echo "spalvos-mode-apply: reloaded the running herdr server"
  fi
fi
